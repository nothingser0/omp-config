{
  "$schema": "https://github.com/can1357/oh-my-pi/raw/main/schemas/mcp.schema.json",
  "mcpServers": {
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "disabled": false
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
      "disabled": false
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/your/allowed/path"],
      "disabled": false
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "YOUR_GITHUB_PAT_HERE"
      },
      "disabled": false
    },
    "figma": {
      "command": "npx",
      "args": ["-y", "figma-mcp", "--stdio"],
      "env": {
        "FIGMA_API_KEY": "YOUR_FIGMA_API_KEY_HERE"
      },
      "disabled": false
    },
    "google-stitch": {
      "command": "npx",
      "args": ["-y", "mcp-stitch"],
      "env": {
        "GOOGLE_API_KEY": "YOUR_GOOGLE_API_KEY_HERE",
        "PROJECT_ROOT": "/your/project/root"
      },
      "disabled": false
    },
    "omahkene-search": {
      "command": "node",
      "args": ["agent/mcp-servers/omahkene-search.js"],
      "env": {
        "OMAHKENE_API_KEY": "YOUR_OMAHKENE_API_KEY_HERE",
        "OMAHKENE_BASE_URL": "YOUR_OMAHKENE_BASE_URL_HERE"
      },
      "disabled": false
    },
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=YOUR_PROJECT_REF",
      "headers": {
        "Authorization": "Bearer YOUR_SUPABASE_BEARER_TOKEN_HERE"
      },
      "disabled": false
    },
    "linear": {
      "command": "npx",
      "args": ["-y", "@mseep/linear-mcp"],
      "env": {
        "LINEAR_API_KEY": "YOUR_LINEAR_API_KEY_HERE"
      },
      "disabled": false
    },
    "postman": {
      "command": "npx",
      "args": ["-y", "@postman/postman-mcp-server"],
      "env": {
        "POSTMAN_API_KEY": "YOUR_POSTMAN_API_KEY_HERE"
      },
      "disabled": true
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@executeautomation/playwright-mcp-server"],
      "disabled": false
    },
    "chrome": {
      "command": "npx",
      "args": ["-y", "@hisma/server-puppeteer"],
      "disabled": false
    },
    "sqlite": {
      "command": "npx",
      "args": ["-y", "mcp-sqlite", "--db-path", "agent/data.db"],
      "disabled": false
    },
    "time": {
      "command": "npx",
      "args": ["-y", "@pylogmonmcp/time"],
      "disabled": false
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "disabled": false
    },
    "postgres": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres", "postgresql://localhost/mydb"],
      "disabled": true
    }
  }
}
